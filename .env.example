# Copy to .env and export before starting:  set -a; source .env; set +a

# REQUIRED in production: long random string (python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=change-me

# Set to 1 when serving over HTTPS
COOKIE_SECURE=0

# Storage: local | s3
STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=./data/blobs

# S3 (pip install -r requirements-s3.txt). Credentials come from the usual AWS
# env vars / profile / IAM role - never put them in code.
# STORAGE_BACKEND=s3
# S3_BUCKET=my-encrypted-bucket
# S3_PREFIX=secure-storage
# S3_REGION=ap-south-1
# S3_ENDPOINT_URL=http://localhost:9000   # MinIO etc.
# S3_SSE=AES256                           # set empty for MinIO without KMS

MAX_UPLOAD_MB=100
SESSION_TTL_SECONDS=1800

QUOTA_MB=500
